[Unit]
Description=Reconcile immutable paper trading image
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/stock-range-deploy/reconcile.py
TimeoutStartSec=1200
UMask=0022

[Install]
WantedBy=multi-user.target
