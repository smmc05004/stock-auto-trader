FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json ./
COPY src/lib ./src/lib
COPY scripts ./scripts
RUN npm run build:paper

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ARG GIT_COMMIT=unknown
LABEL org.opencontainers.image.revision=$GIT_COMMIT
LABEL io.stock-range.deploy-protocol="1" io.stock-range.db-schema="1"
ENV APP_GIT_COMMIT=$GIT_COMMIT
ENV NODE_ENV=production
ENV KIS_TOKEN_CACHE_PATH=/app/data/kis-token.json
RUN mkdir /app/data && chown node:node /app/data
COPY --from=build --chown=node:node /app/dist/*.cjs ./
COPY --chown=node:node scripts/image-smoke.mjs ./image-smoke.mjs
USER node
CMD ["node", "paper-probe.cjs"]
